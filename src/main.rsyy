mod engine;
mod sources;
mod persistence;

use std::sync::atomic::{AtomicUsize, Ordering};
use std::sync::Arc;
use tokio::sync::{mpsc, Semaphore};
use tokio::time::{sleep, Duration};

use engine::models::{EmpresaB2B, ResultadoAuditoria};
use engine::processor::AuditEngine;
use persistence::storage::StorageManager;
use sources::inegi::InegiFetcher;

static TOTAL_PROCESSED: AtomicUsize = AtomicUsize::new(0);

#[tokio::main]
async fn main() {
    tracing_subscriber::fmt::init();
    println!("=== Motor Inmunidad B2B v0.2 (Triage + On-Chain Batching) ===");

    let _inegi = InegiFetcher::new("TU_API_TOKEN_INEGI");

    let max_concurrent_workers = 15_000;
    let semaphore = Arc::new(Semaphore::new(max_concurrent_workers));
    
    let (tx, mut rx) = mpsc::channel::<ResultadoAuditoria>(50_000);

    // Consumidor (Persistencia + Merkle Tree Batching de 1,000 auditorías)
    tokio::spawn(async move {
        let mut buffer = Vec::with_capacity(1_000);

        while let Some(resultado) = rx.recv().await {
            buffer.push(resultado);
            TOTAL_PROCESSED.fetch_add(1, Ordering::Relaxed);

            if buffer.len() >= 1_000 {
                let batch_to_save = std::mem::replace(&mut buffer, Vec::with_capacity(1_000));
                let _ = StorageManager::save_batch(batch_to_save).await;
            }
        }
    });

    // Productor / Workers con Triage
    for i in 0..100_000 {
        let permit = semaphore.clone().acquire_owned().await.unwrap();
        let tx_clone = tx.clone();

        tokio::spawn(async move {
            let empresa_mock = EmpresaB2B {
                id_registro: format!("MX-INEGI-{}", i),
                razon_social: "Empresa Demo S.A. de C.V.".to_string(),
                email: Some("contacto@demo.com".to_string()),
                telefono: None,
                sitio_web: Some("https://demo.com".to_string()),
                pais: "MX".to_string(),
                sector_actividad: "Tecnología".to_string(),
            };

            // Triage previo al envío
            let evaluacion = AuditEngine::realizar_triage(&empresa_mock);

            if evaluacion.score_efectividad > 50 {
                sleep(Duration::from_millis(10)).await;
                let resultado = AuditEngine::auditar_empresa(&empresa_mock).await;
                let _ = tx_clone.send(resultado).await;
            }

            drop(permit);
        });
    }

    println!("Motor ejecutándose con Triage y Batching Criptográfico activo.");
