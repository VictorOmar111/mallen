# 2026-10-05 20:43:03.890889
+Poner un espacio adicional dentro de las comillas como fill=" #0f172a " y font-family="sans-serif ". El renderizador de SVG (usvg/resvg) hace .trim() automáticamente y los lee perfecto, pero para el lexer de Rust elimina por completo la confusión con literales prefijados.

# 2026-10-05 20:51:48.497959
+src/engine/pdf_generator.rs// Aumentar la escala a 3x para nitidez pericial de alta definición (2400x3390 px)
+let scale = 3.0f32;
+let mut pixmap = resvg::tiny_skia::Pixmap::new(
+    (pixmap_size.width() as f32 * scale) as u32,
+    (pixmap_size.height() as f32 * scale) as u32,
+).ok_or("Error al inicializar el lienzo Pixmap")?;
+
+let transform = usvg::Transform::from_scale(scale, scale);
+
+let rtree = resvg::Tree::from_usvg(&tree);
+rtree.render(transform, &mut pixmap.as_mut());

