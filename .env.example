# ==============================================================================
# FIRMA PERICIAL MALLEN 360° (MALLEN.LAT) — CONFIGURACIÓN DE PRODUCCIÓN
# Cuando tengas tus credenciales reales, copia este archivo a `.env` y reinicia:
# cp .env.example .env && sudo systemctl restart mallen.service
# ==============================================================================

MALLEN_BASE_URL=https://mallen.lat

# 1. PERITO AUDITOR C.P.C. Y AGENTE CAPACITADOR EXTERNO STPS (FORMATO DC-5)
MALLEN_AUDITOR_NAME="C.P.C. Víctor Omar Malpica Guillén"
MALLEN_AUDITOR_CEDULA="CED-PERICIAL-2026-MALLEN"
MALLEN_AUDITOR_COLEGIO="Colegio de Contadores Públicos de México"
MALLEN_AUDITOR_DC5_REG="STPS-DC5-MALLEN-0001"
MALLEN_AUDITOR_FIRMA_HASH="0x8f9a2b4c6e1d3f5a7b9c8d0e2f4a6b8c"

# 2. PASARELA DE PAGOS STRIPE (3D SECURE OBLIGATORIO + ANTI-CHARGEBACK)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 3. FACTURACIÓN AUTOMÁTICA CFDI 4.0 (EMISOR FISCAL Y PAC SAT)
SAT_EMISOR_RFC="FPM260101AA1"
SAT_EMISOR_NOMBRE="FIRMA PERICIAL MALLEN"
SAT_EMISOR_REGIMEN="601"
SAT_EMISOR_CP="06600"
PAC_API_URL=""
